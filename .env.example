# Copy to .env (dev) and .env.test (test DB), fill in real values as they become available.

DATABASE_URL="postgresql://user:password@localhost:5432/payout_dev"
SESSION_SECRET="change-me"

# Set to "production" only on the deployed backend. In production the app
# trusts proxy headers, sets a Secure session cookie, and REQUIRES both a
# real SESSION_SECRET and a reachable REDIS_URL (the session store).
NODE_ENV=
# Port the API listens on (platform usually injects this).
PORT=

# Google Cloud service account (Phase 8 — not needed until real Sheets/Docs/Drive providers are wired in)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
# Separate from GOOGLE_DRIVE_FOLDER_ID — KYC documents (Aadhaar/PAN/bank proof)
# stay out of the folder resources get `reader` access to on their own
# invoice doc (HLD §9: "restricted... access limited to admin roles").
GOOGLE_KYC_FOLDER_ID=
GOOGLE_INVOICE_TEMPLATE_ID=

# OAuth (personal-account fallback for Drive writes — service accounts have
# 0 Drive storage quota, only matters on a personal/non-Workspace account,
# see LLD §0.18). Used only for copyTemplate/shareWithEmail/uploadFile;
# Sheets reads stay on the service account above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Resend (Phase 8 — not needed until real EmailProvider is wired in)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Recipient for generic "notify Admin" events (LLD §0.7) - INVOICE_DECLINED etc.
ADMIN_NOTIFICATION_EMAIL=

# Frontend's public base URL (LLD §0.25) — used to build the accept-invite
# link in the INVITE_SENT email. Defaults to http://localhost:4000 if unset;
# must be set for real before inviting real resources in production.
FRONTEND_BASE_URL=

# Redis / BullMQ (Phase 7 — not needed until the queue is wired to real Redis)
REDIS_URL="redis://localhost:6379"
