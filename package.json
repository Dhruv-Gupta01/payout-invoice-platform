{
  "name": "payout-invoice-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Resource Payout & Invoice Automation Platform (Biz-Tech Analytics)",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.2.0",
    "connect-redis": "^7.1.1",
    "csv-parse": "^7.0.2",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "googleapis": "^176.0.0",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "resend": "^6.22.1",
    "to-words": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.4",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
